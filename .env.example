# TwiLearn Environment Variables
# Copy this file to .env and fill in the values for local development

# Django Settings
DEBUG=True
SECRET_KEY=your-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (for local development - uses SQLite by default)
# DATABASE_URL=postgresql://user:password@localhost:5432/twilearn

# CORS Settings
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000